# Copy relevant values into Railway's Variables tab for the backend service.
# Get these from Supabase: Project Settings -> Database -> Connection string (URI) / Connection pooling.

SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Leave DDL_AUTO=update for the first deploy so Hibernate creates the tables in Supabase.
DDL_AUTO=update

# Railway sets PORT automatically; no need to set it manually.
